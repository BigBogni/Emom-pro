let nsVideo=null,csVideo=null,csTimer=null,awakeOn=false,vOk=false;
const playVid=async v=>{try{await v.play();return !v.paused}catch(e){return false}};
async function videoAwake(){
  try{if(!nsVideo){const v=document.createElement('video');v.setAttribute('title','Emom Pro');v.setAttribute('playsinline','');v.setAttribute('muted','');v.muted=true;
    const so=document.createElement('source');so.src="data:video/mp4;base64,";so.type='video/mp4';v.appendChild(so);
    v.addEventListener('timeupdate',()=>{if(v.currentTime>.5)v.currentTime=Math.random()});nsVideo=v}
    if(await playVid(nsVideo))return true}catch(e){}
  try{if(!csVideo){const c=document.createElement('canvas');c.width=c.height=16;const x=c.getContext('2d'),v=document.createElement('video');
    v.setAttribute('playsinline','');v.setAttribute('muted','');v.muted=true;v.srcObject=c.captureStream(10);csVideo=v;
    csTimer=setInterval(()=>{x.fillStyle='rgb('+(Math.random()*255|0)+',40,40)';x.fillRect(0,0,16,16)},400)}
    return await playVid(csVideo)}catch(e){return false}}
function showAwake(){const on=!!lock||vOk,el=$('#awake');if(!el)return;
  el.textContent=!awakeOn?'':on?'Écran maintenu allumé':'Écran non maintenu : règle « Verrouillage auto » sur « Jamais » dans les réglages iPhone';
  el.classList.toggle('bad',awakeOn&&!on)}
async function keepAwake(){awakeOn=true;
