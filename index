  try{if(navigator.wakeLock){lock=await navigator.wakeLock.request('screen');lock.addEventListener('release',()=>{lock=null;showAwake()})}}catch(e){}
  vOk=await vp;showAwake()}
function releaseAwake(){awakeOn=false;try{lock&&lock.release()}catch(e){}lock=null;vOk=false;
  try{nsVideo&&nsVideo.pause()}catch(e){}try{csVideo&&csVideo.pause();clearInterval(csTimer);csVideo=null}catch(e){}showAwake()}
