th d="M12 18v3"/></symbol><symbol id="i-play" viewBox="0 0 24 24"><path d="M8 5v14l11-7z" fill="currentColor" stroke="none"/></symbol><symbol id="i-trophy" viewBox="0 0 24 24"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0z"/><path d="M17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/></symbol><symbol id="i-award" viewBox="0 0 24 24"><path d="M6 9a6 6 0 1 0 12 0a6 6 0 1 0 -12 0"/><path d="M8.5 14.5 7 22l5-3 5 3-1.5-7.5"/></symbol><symbol id="i-list" viewBox="0 0 24 24"><path d="M8 3h8v3H8z"/><path d="M6 5H5a1 1 0 0 0-1 1v15a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1h-1"/><path d="M8 12h8M8 16h5"/></symbol><symbol id="i-download" viewBox="0 0 24 24"><path d="M12 3v12"/><path d="M7 11l5 5 5-5"/><path d="M4 20h16"/></symbol><symbol id="i-upload" viewBox="0 0 24 24"><path d="M12 16V4"/><path d="M7 8l5-5 5 5"/><path d="M4 20h16"/></symbol><symbol id="i-refresh" viewBox="0 0 24 24"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></symbol><symbol id="i-save" viewBox="0 0 24 24"><path d="M5 3h11l3 3v15H5z"/><path d="M8 3v5h7V3"/><path d="M8 21v-6h8v6"/></symbol><symbol id="i-copy" viewBox="0 0 24 24"><path d="M9 9h11v11H9z"/><path d="M5 15V5a1 1 0 0 1 1-1h10"/></symbol><symbol id="i-pencil" viewBox="0 0 24 24"><path d="M4 20l1-4L16.5 4.5a2 2 0 0 1 3 3L8 19z"/><path d="M14 7l3 3"/></symbol><symbol id="i-x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6 6 18"/></symbol><symbol id="i-chev" viewBox="0 0 24 24"><path d="M6 9l6 6 6-6"/></symbol><symbol id="i-star" viewBox="0 0 24 24"><path d="M12 3l2.8 5.8 6.2.9-4.5 4.4 1 6.3L12 17.4l-5.5 3 1-6.3L3 9.7l6.2-.9z"/></symbol><symbol id="i-sun" viewBox="0 0 24 24"><path d="M8 12a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></symbol><symbol id="i-moon" viewBox="0 0 24 24"><path d="M21 13A9 9 0 1 1 11 3a7 7 0 0 0 10 10z"/></symbol><symbol id="i-venus" viewBox="0 0 24 24"><path d="M7 9a5 5 0 1 0 10 0a5 5 0 1 0 -10 0"/><path d="M12 14v8M9 18h6"/></symbol><symbol id="i-mars" viewBox="0 0 24 24"><path d="M5 14a5 5 0 1 0 10 0a5 5 0 1 0 -10 0"/><path d="M14 10l6-6M15 4h5v5"/></symbol><symbol id="i-search" viewBox="0 0 24 24"><path d="M4 11a7 7 0 1 0 14 0a7 7 0 1 0 -14 0M20 20l-4-4"/></symbol><symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></symbol><symbol id="i-camera" viewBox="0 0 24 24"><path d="M4 8h3l1.5-2h7L17 8h3v11H4z"/><path d="M8.5 13a3.5 3.5 0 1 0 7.0 0a3.5 3.5 0 1 0 -7.0 0"/></symbol><symbol id="i-users" viewBox="0 0 24 24"><path d="M5.5 8a3.5 3.5 0 1 0 7.0 0a3.5 3.5 0 1 0 -7.0 0M2.5 20c0-3.6 2.9-5.5 6.5-5.5s6.5 1.9 6.5 5.5"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7"/><path d="M17.5 14.7c2.5.5 4 2.2 4 5.3"/></symbol><symbol id="i-userplus" viewBox="0 0 24 24"><path d="M6 8a4 4 0 1 0 8 0a4 4 0 1 0 -8 0M2.5 21c0-3.8 3.4-6 7.5-6"/><path d="M19 8v6M16 11h6"/></symbol><symbol id="i-arrowleft" viewBox="0 0 24 24"><path d="M19 12H5M11 6l-6 6 6 6"/></symbol></defs></svg>
<nav id="tabs" aria-label="Navigation"><i class="pill" aria-hidden="true"></i><button class="on" data-t="setup" aria-label="Chrono"><span class="ti"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-timer"/></svg></span></button><button data-t="perf" aria-label="Performances"><span class="ti"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-chart"/></svg></span></button><button data-t="profile" aria-label="Profil"><span class="ti"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-user"/></svg></span></button><button data-t="settings" aria-label="Paramètres"><span class="ti"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-sliders"/></svg></span></button></nav>
<main id="setup">
  <h1>Emom Pro</h1>
  <p class="sub">Règle ta séance, puis lance le chrono.</p>
  <div class="seg" id="modes"><button data-m="emom"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-bolt"/></svg>Emom</button><button data-m="pyramid"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-pyramid"/></svg>Pyramide</button><button data-m="amrap"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-repeat"/></svg>AMRAP</button></div>
    <div class="row m-sa" id="r-rounds"><div>Séries</div><div class="step"><button class="rd" id="sw-inf" role="switch" aria-label="Mode infini" title="Mode infini">∞</button><button class="rd" data-k="rounds" data-d="-1" aria-label="Moins">−</button><input type="number" inputmode="numeric" class="num" id="v-rounds" min="0" aria-label="Valeur"><button class="rd" data-k="rounds" data-d="1" aria-label="Plus">+</button></div></div>
  <div class="row m-sa" id="r-reps"><div>Reps par série<small>Valeur de départ, modifiable en séance</small></div><div class="step"><button class="rd" data-k="reps" data-d="-1" aria-label="Moins">−</button><input type="number" inputmode="numeric" class="num" id="v-reps" min="0" aria-label="Valeur"><button class="rd" data-k="reps" data-d="1" aria-label="Plus">+</button></div></div>
  <div class="row m-sa"><div>Durée d'une série<small id="w-small">secondes</small></div><div class="step"><button class="rd" data-k="work" data-d="-5" aria-label="Moins">−</button><input type="number" inputmode="numeric" class="num" id="v-work" min="0" aria-label="Valeur"><button class="rd" data-k="work" data-d="5" aria-label="Plus">+</button></div></div>
  <div class="row m-p"><div>Départ<small>reps à la 1re série</small></div><div class="step"><button class="rd" data-k="pStart" data-d="-1" aria-label="Moins">−</button><input type="number" inputmode="numeric" class="num" id="v-pStart" min="0" aria-label="Valeur"><button class="rd" data-k="pStart" data-d="1" aria-label="Plus">+</button></div></div>
  <div class="row m-p"><div>Palier<small>reps ajoutées à chaque série</small></div><div class="step"><button class="rd" data-k="pStep" data-d="-1" aria-label="Moins">−</button><input type="number" inputmode="numeric" class="num" id="v-pStep" min="0" aria-label="Valeur"><button class="rd" data-k="pStep" data-d="1" aria-label="Plus">+</button></div></div>
  <div class="row m-p"><div>Maximum<small>reps au sommet de la pyramide</small></div><div class="step"><button class="rd" data-k="pMax" data-d="-1" aria-label="Moins">−</button><input type="number" inputmode="numeric" class="num" id="v-pMax" min="0" aria-label="Valeur"><button class="rd" data-k="pMax" data-d="1" aria-label="Plus">+</button></div></div>
  <div class="row m-p"><div>Durée d'une série<small>secondes</small></div><div class="step"><button class="rd" data-k="work" data-d="-5" aria-label="Moins">−</button><input type="number" inputmode="numeric" class="num" id="v-work2" min="0" aria-label="Valeur"><button class="rd" data-k="work" data-d="5" aria-label="Plus">+</button></div></div>
  <div class="seg m-a" id="atype"><button data-at="time"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-hourglass"/></svg>Temps limité</button><button data-at="rounds"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-target"/></svg>Nombre de tours</button></div>
  <div class="row m-a a-time"><div>Durée totale<small>minutes pour faire un max de tours</small></div><div class="step"><button class="rd" data-k="aMin" data-d="-1" aria-label="Moins">−</button><input type="number" inputmode="numeric" class="num" id="v-aMin" min="0" aria-label="Valeur"><button class="rd" data-k="aMin" data-d="1" aria-label="Plus">+</button></div></div>
  <div class="row m-a a-rounds"><div>Nombre de tours<small>à terminer, le chrono défile</small></div><div class="step"><button class="rd" data-k="aRounds" data-d="-1" aria-label="Moins">−</button><input type="number" inputmode="numeric" class="num" id="v-aRounds" min="0" aria-label="Valeur"><button class="rd" data-k="aRounds" data-d="1" aria-label="Plus">+</button></div></div>
  <div class="m-a"><div class="seg"><button id="mv-btn" aria-expanded="false"><span class="ic-l"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-dumbbell"/></svg></span>Mouvement / circuit <span class="chev"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-chev"/></svg></span></button></div><div class="acc" id="mvs"><div class="acc-in"><div class="card" style="margin:0 0 4px"><b>Mouvement ou circuit</b><p class="sub" style="margin:2px 0 10px;font-size:14px">Ajoute un mouvement, ou plusieurs pour un circuit : chaque tour les regroupe tous.</p><div id="a-pick"></div><div class="row" style="background:var(--bg)"><div>Répétitions</div><div class="step"><button class="rd" id="a-rm" aria-label="Moins">−</button><input type="number" inputmode="numeric" class="num" id="a-r" min="1" value="10" aria-label="Répétitions"><button class="rd" id="a-rp" aria-label="Plus">+</button></div></div><button class="wide" id="a-add">Ajouter au tour</button><div class="list" id="a-list"></div></div></div></div><div class="card hide" id="am-tot"></div></div>
  <div class="adv"><div class="seg"><button id="opt-btn" aria-expanded="false"><span class="ic-l"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-sliders"/></svg></span>Paramètres supplémentaires <span class="chev"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-chev"/></svg></span></button></div><div class="acc" id="opts"><div class="acc-in">
  <div class="row adv"><div>EMOM Stop<small>Chaque série démarre en pause : fais tes reps, puis relance le chrono pour lancer le repos</small></div><button class="sw" id="sw-stop" role="switch" aria-label="EMOM Stop"></button></div>
  <div class="card adv"><b>Exercices de l'EMOM</b><p class="sub" style="margin:2px 0 10px;font-size:14px">Avec plusieurs exercices, ils alternent à chaque série.</p><div id="s-pick"></div><button class="wide" id="s-add">Ajouter à l'EMOM</button><div class="list" id="s-list"></div></div>
  </div></div></div>
  <button class="big" id="go">Démarrer</button>
  <div id="infob" style="margin-top:10px">
  <div class="row" id="r-pot"><div>Total potentiel<small>Séries × reps, à titre indicatif</small></div><b class="pot" id="v-pot"></b></div>
  <div class="row" id="r-dur"><div>Durée totale<small>Sans le décompte de départ</small></div><b class="pot" id="v-dur"></b></div>
  </div>
</main>

<main id="run" class="hide">
  <div class="top"><span class="chip" id="chip"></span><button class="rd vb" id="vbtn" aria-label="Volume"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-volume"/></svg></button></div>
  <div class="sprog"><i id="sprog"></i></div>
  <div class="pop hide" id="vpop"><div class="vs"><input type="range" id="vol2" min="0" max="100" step="5" aria-label="Volume des effets sonores"><span><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-bell"/></svg></span></div><div class="vs"><input type="range" id="vvol2" min="0" max="100" step="5" aria-label="Volume de la voix"><span><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-mic"/></svg></span></div></div>
  <div class="phase" id="phase"></div>
  <div class="rlab" id="rlab"></div>
  <div class="exn" id="exn"></div>
  <div class="ringbox" role="button" tabindex="0" aria-label="Pause ou reprise"><svg viewBox="0 0 200 200" aria-hidden="true"><circle class="rt" cx="100" cy="100" r="92"/><circle class="rp" id="ring" cx="100" cy="100" r="92"/></svg><p class="time" id="time" aria-live="off">0</p><span class="pico" aria-hidden="true"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-play"/></svg></span></div>
  <div class="tl" id="tl"></div><div class="tbarw"><i id="tbar"></i></div>
  <button class="big lapbtn hide" id="lap"><b id="lapn">0</b><span>+1 tour</span></button>
  <p class="hint" id="hint"></p>
  <p class="hint" id="hint2"></p>
  <div class="rep" id="rep"><div class="rl">Répétitions de cette série</div>
    <div class="step"><button class="rd" id="rm" aria-label="Une rep de moins">−</button><input type="number" inputmode="numeric" class="num" id="rcur" min="0" value="0" aria-label="Reps de cette série"><button class="rd" id="rp" aria-label="Une rep de plus">+</button></div>
    <p>Total <b id="rtot">0</b><span id="rpot"></span></p>
  </div>
  <div class="mvcard hide" id="mvl"></div>
  <div class="btns"><button class="big alt" id="pause">Pause</button><button class="big alt" id="stop">Terminer</button></div>
</main>

<main id="done" class="hide">
  <div class="banner" id="d-banner"><h1>Séance terminée</h1>
  <p class="sub" id="d-fmt" style="margin-bottom:4px"></p>
  <p class="sub" id="d-ex"></p>
  <div class="gold hide" id="d-rec"><span><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-trophy"/></svg>Nouveau record</span><small id="d-recs"></small></div>
  <div class="card hide" id="d-chart" style="padding:10px"></div>
  <div class="hero" id="d-hero"><b id="d-tot">0</b><span id="d-unit">répétitions</span></div></div>
  <div class="tiles" id="d-tiles"></div>
  <button class="big alt dk" id="d-detail"><span class="ic-l"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-list"/></svg></span>Détail des séries</button>
  <button class="big alt dk" id="dsave">Enregistrer dans Performances</button>
  <button class="big alt dk" id="d-recap"><span class="ic-l"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-download"/></svg></span>Télécharger le récap</button>
  <button class="big" id="again"><span class="ic-l"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-refresh"/></svg></span>Nouvelle séance</button>
</main>

<main id="detail" class="hide">
  <h1>Détail des séries</h1>
  <div class="tw"><table><thead id="dt-head"></thead><tbody id="dt-body"></tbody><tfoot id="dt-foot"></tfoot></table></div>
  <button class="big alt dk" id="dt-back" style="margin-top:auto">Retour</button>
</main>

<main id="recap" class="hide">
  <h1>Récap de la séance</h1>
  <div class="card">
    <label style="margin-bottom:6px">Style du récap</label><div class="seg" id="rstyle"><button data-rs="classic">Classique</button><button data-rs="minimal">Minimal</button><button data-rs="cards">Cartes</button><button data-rs="detail">Détail</button></div>
    <label>Nom de la séance<input type="text" id="rname" maxlength="40" value="Séance EMOM"></label>
    <label>Date<input type="date" id="rdate"></label>
    <div class="grid3"><label>Fond<input type="color" id="rbg" value="#14191f"></label><label>Texte<input type="color" id="rfg" value="#ffffff"></label><label>Transparent<button class="sw" id="rtr" role="switch" aria-label="Fond transparent" style="display:block;margin-top:10px"></button></label></div>
  </div>
  <div class="rprev"><img id="rimg" alt="Récap de la séance"></div>
  <canvas id="rcv" width="1080" height="1350" class="hide"></canvas>
  <p class="sub" id="rmsg"></p>
  <button class="big" id="rdl"><span class="ic-l"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-download"/></svg></span>Télécharger l'image</button>
  <button class="big alt dk" id="rback">Retour</button>
</main>

<main id="settings" class="hide">
  <h1>Paramètres</h1>
  <p class="sub">Ajuste l'apparence, les sons et tes données.</p>
  <h3 class="sec">Apparence</h3>
  <div class="card sc"><div class="row"><div>Thème<small id="th-lab"></small></div><button class="tsw t-theme" id="sw-theme" role="switch" aria-label="Basculer entre thème clair et sombre"><span class="k"></span></button></div></div>
  <h3 class="sec">Sons et voix</h3>
  <div class="card sc"><div class="row"><div>Effets sonores</div><input type="range" id="vol" min="0" max="100" step="5" aria-label="Volume des sons"></div>
    <div class="row"><div>Voix</div><input type="range" id="vvol" min="0" max="100" step="5" aria-label="Volume de la voix"></div>
    <div class="row"><div>Genre de la voix<small id="g-lab"></small></div><button class="tsw t-gender" id="sw-gender" role="switch" aria-label="Basculer entre voix de femme et voix d'homme"><span class="k"></span></button></div>
    <div class="row"><div>Continuer ma musique<small>Les sons se mélangent à ta musique ; le mode silencieux les coupe</small></div><button class="sw" id="sw-mix" role="switch" aria-label="Continuer ma musique"></button></div></div>
  <h3 class="sec">Séance</h3>
  <div class="card sc"><div class="row"><div>Compter les répétitions<small>Total pendant et à la fin</small></div><button class="sw" id="sw-count" role="switch" aria-label="Compter les répétitions"></button></div></div>
  <h3 class="sec">Données</h3>
  <div class="card sc"><div class="row"><div>Sauvegarde<small>Exporter ou importer tes données</small></div><button class="rd" id="bk-open" aria-label="Sauvegarde des données"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-save"/></svg></button></div></div>
</main>
<main id="perf" class="hide">
  <h1>Performances</h1>
  <p class="sub">Note tes dernières séances ou tes records pour suivre ta progression.</p>
  <div class="seg" id="psub"><button class="on" data-ps="train"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-dumbbell"/></svg>Entraînements</button><button data-ps="goals"><svg class="ic" aria-hidden="true" focusable="false"><use href="#i-target"/></svg>Objectifs</button></div>
  <div id="p-train">
  <div class="card">
    <div id="p-pick"></div>
    <div class="grid3">
      <label>Séries<input type="number" id="p-s" inputmode="numeric" min="1" value="10"></label>
      <label>Reps par série<input type="number" id="p-r" inputmode="numeric" min="1" value="5"></label>
      <label>Durée (s)<input type="number" id="p-d" inputmode="numeric" min="10" value="60"></label>
    </div>
    <label>Date<input type="date" id="p-date"></label>
    <button class="big" id="p-add">Ajouter la performance</button>
    <button class="wide hide" id="p-cancel">Annuler la modification</button>
  </div>
  <label>Afficher<select id="p-filter"></select></label>
  <p class="prog" id="p-prog"></p>
  <div class="card" id="p-chart"></div>
  <div class="tw"><table><thead><tr><th>Date</th><th>Exercice</th><th>Séries × reps</th><th>Durée</th><th>Total</th><th></th></tr></thead><tbody id="p-body"></tbody></table></div>
  <p class="sub" id="p-empty">Aucune performance pour l'instant. Ajoute la première ci-dessus.</p>
  <p class="sub" id="p-sync"></p>
</div>
  <div id="p-goals" class="hide">
