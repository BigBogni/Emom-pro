<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>Emom Pro</title>
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="Emom Pro">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#14191F">
<meta name="format-detection" content="telephone=no">
<link rel="apple-touch-icon" sizes="180x180" href="data:image/png;base64,">
<link rel="icon" type="image/png" sizes="64x64" href="data:image/png;base64,">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;800&family=Barlow:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#14191F;--ink:#E7ECEF;--mute:#93A0A8;--card:#1E262E;--line:#313C46;--work:#3D5CF0;--rest:#0F8F71;--wait:#2A343D;--pyr:#D9600A;--amr:#D42B36;--bg2:#1C2638;--gm:26%;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:dark}
:root[data-theme="light"]{--bg:#EEF2F7;--ink:#0F1720;--mute:#5A6878;--card:#FFFFFF;--line:#D3DAE4;--work:#3D5CF0;--rest:#0F8F71;--wait:#5B6B78;--bg2:#FFFFFF;--gm:14%;color-scheme:light}
:root[data-theme="light"] .card,:root[data-theme="light"] .row,:root[data-theme="light"] .tile{box-shadow:0 1px 3px rgba(15,23,32,.07)}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%}
body{background:var(--bg);color:var(--ink);font:400 17px/1.4 Barlow,system-ui,sans-serif;transition:background-color .35s}
body.work{background-color:var(--work);color:#fff}
body.rest{background-color:var(--rest);color:#fff}
body.wait{background-color:var(--wait);color:#fff}
main{max-width:480px;margin:0 auto;padding:20px 20px calc(112px + env(safe-area-inset-bottom,0px));min-height:100vh;display:flex;flex-direction:column}
#run{min-height:100vh;padding-bottom:32px}
h1{font:800 34px/1 "Barlow Condensed",Impact,sans-serif;margin:8px 0 4px;letter-spacing:.5px}
.sub{color:var(--mute);margin:0 0 20px}
.row{display:flex;align-items:center;justify-content:space-between;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px 14px;margin-bottom:10px}
.row small{display:block;color:var(--mute);font-size:13px}
.row.off{opacity:.45;pointer-events:none}
.step{display:flex;align-items:center;gap:6px}
.step b{min-width:64px;text-align:center;font:800 26px "Barlow Condensed",sans-serif;font-variant-numeric:tabular-nums}
button{font:inherit;cursor:pointer;border:0;color:inherit}
.rd{width:44px;height:44px;border-radius:50%;background:var(--bg);border:1px solid var(--line);font-size:24px;line-height:1}
.sw{width:52px;height:30px;border-radius:15px;background:var(--line);position:relative;flex:none}
.sw::after{content:"";position:absolute;top:3px;left:3px;width:24px;height:24px;border-radius:50%;background:#fff;transition:transform .15s}
.sw.on{background:var(--work)}.sw.on::after{transform:translateX(22px)}
.big{width:100%;padding:18px;border-radius:16px;background:var(--work);color:#fff;font:800 24px "Barlow Condensed",sans-serif;letter-spacing:.5px;margin-top:auto}
.big.alt{background:transparent;border:2px solid currentColor;margin-top:10px}
:focus-visible{outline:3px solid #FFB020;outline-offset:2px}
.hide{display:none!important}
/* course */
.top{display:flex;justify-content:space-between;font:600 20px "Barlow Condensed",sans-serif;opacity:.9}
.phase{font:800 40px "Barlow Condensed",sans-serif;margin:24px 0 0;text-align:center}
.time{font:800 min(38vw,190px)/1 "Barlow Condensed",Impact,sans-serif;text-align:center;font-variant-numeric:tabular-nums;margin:0}
.rep{background:rgba(255,255,255,.14);border-radius:16px;padding:14px;margin:20px 0 14px}
.rep .step{justify-content:center;gap:14px}
.rep .rd{background:rgba(255,255,255,.2);border:0;color:#fff}
.rep b{font-size:44px;min-width:80px}
.rep p{margin:6px 0 0;text-align:center;opacity:.9}
.btns{display:flex;gap:10px;margin-top:auto}
.btns .big{margin-top:0}
input[type=range]{accent-color:var(--work);width:150px}
.pot{font:800 26px "Barlow Condensed",sans-serif}
.vol{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:0 0 14px;opacity:.9}
.vol input{accent-color:#fff;flex:1}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:16px}
label{display:block;color:var(--mute);font-size:14px;margin-bottom:10px}
input[type=text],input[type=number],input[type=date],select{width:100%;padding:11px 12px;margin-top:4px;font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:10px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.card .big{margin-top:4px;padding:14px}
.tw{overflow-x:auto}
table{width:100%;border-collapse:collapse;font-size:15px}
th,td{padding:8px 5px;text-align:left;border-bottom:1px solid var(--line);font-variant-numeric:tabular-nums}
th{color:var(--mute);font-weight:600;font-size:13px}
.rec{background:var(--work);color:#fff;border-radius:6px;padding:1px 6px;font-size:12px;white-space:nowrap}
.x{width:32px;height:32px;font-size:18px}
.prog{margin:0 0 12px;font-weight:600}
.wide{width:100%;padding:12px;margin-top:8px;border-radius:12px;background:var(--bg);border:1px solid var(--line);font:600 17px Barlow,sans-serif;color:var(--ink)}
#dsave{color:var(--ink)}
#p-chart:empty{display:none}
#p-chart{margin-bottom:12px}
.exn{text-align:center;font:600 26px "Barlow Condensed",sans-serif;min-height:1.2em}
.list span[data-i]{cursor:pointer}
.seg{display:flex;gap:8px;margin:0 0 12px}
.seg button{flex:1;padding:10px;border-radius:12px;background:transparent;border:1px solid var(--line);font:600 17px Barlow,sans-serif;color:var(--mute)}
.seg button.on{background:var(--ink);color:var(--bg);border-color:var(--ink)}
#setup[data-mode="simple"] .adv{display:none}
input.num{width:56px;margin:0;padding:4px 0;text-align:center;font:800 26px "Barlow Condensed",sans-serif;color:inherit;background:transparent;border:1px solid transparent;border-radius:8px;-moz-appearance:textfield;appearance:textfield}
input.num:focus{border-color:var(--line);background:var(--bg)}
input.num::-webkit-inner-spin-button,input.num::-webkit-outer-spin-button{-webkit-appearance:none;margin:0}
.rep input.num{font-size:44px;width:96px;color:#fff}
.rep input.num:focus{background:rgba(255,255,255,.18);border-color:rgba(255,255,255,.4)}
.step{gap:4px}
.rd.on{background:var(--work);color:#fff;border-color:var(--work)}
#sw-inf{font:800 28px/1 "Barlow Condensed",sans-serif}
#r-rounds.isinf [data-k],#r-rounds.isinf input.num{opacity:.35;pointer-events:none}
#r-pot,#r-dur{border-style:dashed;background:color-mix(in srgb,var(--rest) 12%,transparent)}
#r-pot .pot,#r-dur .pot{color:var(--rest)}
.brand{display:flex;align-items:center;gap:12px}
.brand img{border-radius:11px}
button{transition:transform .15s ease,background-color .2s,border-color .2s,opacity .2s,color .2s}
button:active:not(:disabled){transform:scale(.94)}
.big:active:not(:disabled){transform:scale(.97)}
input.num,input,select{transition:border-color .2s,background-color .2s}
main:not(.hide){animation:pin .35s cubic-bezier(.2,.8,.2,1)}
.card:not(.hide),.row.adv,.pop:not(.hide),tbody tr{animation:pin .28s ease}
.list span{animation:pop .2s ease}
.tile{animation:pin .45s both}.tile:nth-child(2){animation-delay:.05s}.tile:nth-child(3){animation-delay:.1s}.tile:nth-child(4){animation-delay:.15s}.tile:nth-child(5){animation-delay:.2s}.tile:nth-child(6){animation-delay:.25s}
@keyframes pin{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
@keyframes pop{from{opacity:0;transform:scale(.8)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
#run{position:relative}
.top{align-items:center}
.vb{background:rgba(255,255,255,.2);border:0;color:#fff;font-size:20px}
.pop{position:absolute;right:20px;top:68px;z-index:5;display:flex;align-items:center;gap:12px;background:var(--card);color:var(--ink);border:1px solid var(--line);border-radius:14px;padding:12px 14px;box-shadow:0 8px 24px rgba(0,0,0,.25)}
.pop input{width:150px;accent-color:var(--work)}
.ringbox{position:relative;width:min(66vw,280px);aspect-ratio:1;margin:14px auto 6px}
.ringbox svg{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg)}
.ringbox circle{fill:none;stroke-width:9}
.rt{stroke:rgba(255,255,255,.2)}
.rp{stroke:#fff;stroke-dasharray:578.05;stroke-dashoffset:0}
.ringbox .time{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;margin:0;font-size:min(22vw,96px)}
.dk{color:var(--ink)!important}
.gold{display:flex;flex-direction:column;align-items:center;gap:2px;padding:10px 14px;border-radius:14px;background:linear-gradient(135deg,#F7D154,#D99A00);color:#3A2600;font:800 26px "Barlow Condensed",sans-serif;margin:6px 0 14px;text-align:center;animation:pop .5s}
.gold small{font:600 14px Barlow,sans-serif}
.hero{text-align:center;margin:4px 0 12px}
.hero b{display:block;font:800 120px/1 "Barlow Condensed",sans-serif;color:var(--work)}
.hero span{color:var(--mute);font-size:18px}
.tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.tile{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px 14px}
.tile b{display:block;font:800 34px/1.1 "Barlow Condensed",sans-serif}
.tile span{color:var(--mute);font-size:14px}
tfoot td{border-top:2px solid var(--ink);font-size:18px}
input[type=color]{width:100%;height:44px;padding:2px;margin-top:4px;border:1px solid var(--line);border-radius:10px;background:var(--bg)}
.rprev{border-radius:14px;padding:10px;margin:0 0 12px;background:repeating-conic-gradient(#8884 0 25%,#8882 0 50%) 50%/20px 20px}
.rprev img{width:100%;display:block;border-radius:8px}
#setup:not([data-mode="emom"]) .adv,#setup:not([data-mode="emom"]) .m-sa,#setup:not([data-mode="pyramid"]) .m-p,#setup:not([data-mode="amrap"]) .m-a{display:none}
#setup[data-atype="time"] .a-rounds,#setup[data-atype="rounds"] .a-time{display:none}
#modes button{font-size:16px;padding:10px 6px}
#theme button{flex:none;padding:8px 12px;font-size:15px}
.top{justify-content:flex-end}
.rlab{text-align:center;font:600 24px "Barlow Condensed",sans-serif;opacity:.92;min-height:1.2em}
.pop{width:52px;height:180px;padding:0;display:block}
.pop input{position:absolute;left:50%;top:50%;width:140px;transform:translate(-50%,-50%) rotate(-90deg)}
.ringbox{cursor:pointer}
.pico{position:absolute;inset:0;display:none;align-items:center;justify-content:center;font-size:76px;pointer-events:none;z-index:2;text-shadow:0 2px 14px rgba(0,0,0,.4)}
.ringbox.paused .pico{display:flex}
.ringbox.paused .time{opacity:.25}
.acts{display:flex;flex-direction:column;gap:4px}
.hint{text-align:center;opacity:.92;margin:2px 0 0;min-height:1.4em;font-size:16px}
.x.del{width:38px;height:38px;font-size:21px;padding:0}
::view-transition-old(root),::view-transition-new(root){animation:none;mix-blend-mode:normal}
::view-transition-new(root){z-index:2}
html.vt *{transition:none!important}
html.tfade *,html.tfade *::before,html.tfade *::after{transition:background-color .6s ease,color .6s ease,border-color .6s ease,box-shadow .6s ease,fill .6s ease,stroke .6s ease!important}
.acts .x{width:38px;height:38px;font-size:20px;padding:0}
.pop{display:flex;gap:16px;width:auto;height:auto;padding:10px 16px}
.vs{position:relative;width:34px;height:178px}
.vs input{position:absolute;left:50%;top:72px;width:136px;transform:translate(-50%,-50%) rotate(-90deg)}
.vs span{position:absolute;bottom:0;left:0;right:0;text-align:center;font-size:18px}
.acc{display:grid;grid-template-rows:0fr;opacity:0;visibility:hidden;margin-bottom:0;transition:grid-template-rows .45s cubic-bezier(.4,0,.2,1),opacity .35s ease,margin-bottom .45s ease,visibility 0s .45s}
.acc.open{grid-template-rows:1fr;opacity:1;visibility:visible;margin-bottom:12px;transition-delay:0s}
.acc-in{overflow:hidden;min-height:0}
.chev{display:inline-block;transition:transform .35s ease}
#vgen button{flex:none;padding:8px 12px;font-size:15px}
#rstyle button{font-size:14px;padding:8px 2px}
.ringbox:focus-visible{outline-offset:6px;border-radius:50%}
.tsw{position:relative;flex:none;width:76px;height:40px;border-radius:20px;background:var(--line);transition:background-color .35s ease}
.tsw.on{background:var(--work)}
.tsw .k{position:absolute;top:3px;left:3px;width:34px;height:34px;border-radius:50%;background:#fff;display:flex;align-items:center;justify-content:center;font-size:19px;box-shadow:0 1px 4px rgba(0,0,0,.3);transition:transform .35s cubic-bezier(.4,0,.2,1)}
.tsw.on .k{transform:translateX(36px)}
.lapbtn{background:#fff!important;color:#0F1720!important;font-size:28px;margin:12px 0 0!important}
.tsw{isolation:isolate;overflow:hidden;box-shadow:inset 0 1px 3px rgba(0,0,0,.25)}
.tsw .k{z-index:3;transition:transform .35s cubic-bezier(.4,0,.2,1),width .2s ease}
.tsw:active .k{width:40px}
.tsw.on:active .k{transform:translateX(30px)}
#am-tot{border-style:dashed;background:color-mix(in srgb,var(--rest) 12%,transparent)}
#am-tot .ln{display:flex;justify-content:space-between;gap:12px;padding:4px 0}
#am-tot .ln b{color:var(--rest);font:800 24px "Barlow Condensed",sans-serif}
#setup[data-mode="amrap"] #infob{display:none}
.ringbox.am{width:auto;aspect-ratio:auto;margin:2px auto 0}
.ringbox.am svg{display:none}
.ringbox.am .time{position:static;font-size:min(19vw,78px);line-height:1.05}
.ringbox.am .pico{font-size:44px}
.lapbtn{width:min(58vw,250px);height:min(58vw,250px);border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:0;gap:0;margin:14px auto 0!important}
.lapbtn b{font:800 min(28vw,118px)/1 "Barlow Condensed",sans-serif;display:block}
.lapbtn span{font:800 30px "Barlow Condensed",sans-serif;letter-spacing:.5px}
body.work.m-pyramid{background-color:var(--pyr)}
body.work.m-amrap{background-color:var(--amr)}
.lapbtn b small{font-size:.32em;opacity:.55;font-weight:800}
#run.am #phase,#run.am #rlab,#run.am #exn,#run.am #hint,#run.am #hint2{display:none}
#run.am .top{justify-content:space-between}
.chip{background:rgba(255,255,255,.18);border-radius:999px;padding:6px 14px;font:800 20px "Barlow Condensed",sans-serif;letter-spacing:.5px}
#run:not(.am) .tl,#run:not(.am) .tbarw{display:none}
.tl{text-align:center;opacity:.85;font:600 20px "Barlow Condensed",sans-serif;min-height:1.2em}
.tbarw{width:min(64vw,260px);height:6px;border-radius:3px;background:rgba(255,255,255,.22);margin:8px auto 30px;overflow:hidden}
.tbarw i{display:block;height:100%;width:100%;background:#fff;border-radius:3px}
#run.am .lapbtn{width:min(62vw,265px);height:min(62vw,265px);margin:auto auto 26px!important;box-shadow:0 0 0 12px rgba(255,255,255,.16),0 0 0 26px rgba(255,255,255,.08),0 10px 30px rgba(0,0,0,.25)}
.mvcard{background:rgba(255,255,255,.14);border-radius:16px;padding:10px 14px;margin:auto 0 12px}
.mvh,.mvl{display:flex;justify-content:space-between;gap:12px}
.mvh{font-size:13px;opacity:.75;margin-bottom:4px}
.mvl{font:600 20px Barlow,sans-serif;padding:3px 0;align-items:baseline}
.mvl b{font:800 26px "Barlow Condensed",sans-serif}
#run.am .btns{margin-top:0}
#run.am .mvcard.hide+.btns{margin-top:auto}
body.work,body.rest,body.wait{background-image:radial-gradient(120% 60% at 50% 0%,rgba(255,255,255,.18),rgba(255,255,255,0) 60%),linear-gradient(170deg,rgba(255,255,255,.10) 0%,rgba(255,255,255,0) 40%,rgba(0,0,0,.24) 100%);background-attachment:fixed;background-repeat:no-repeat}
.top{justify-content:space-between}
#run:not(.am) #rlab{display:none}
.sprog{height:5px;background:rgba(255,255,255,.22);border-radius:3px;margin:12px 0 0;overflow:hidden}
.sprog i{display:block;height:100%;width:0;background:#fff;border-radius:3px;transition:width .5s ease}
#run.am .sprog{display:none}
.phase{font-size:34px;margin:16px 0 0}
.exn:not(:empty){display:table;margin:8px auto 0;padding:4px 16px;background:rgba(255,255,255,.16);border-radius:999px;font-size:22px;min-height:0}
.ringbox{width:min(70vw,290px)}
.rep{border-radius:20px;padding:12px 12px 10px;margin:14px 0 12px}
.rep .rl{text-align:center;font:600 15px Barlow,sans-serif;opacity:.8}
.rep .rd{width:56px;height:56px;font-size:30px}
.rep .step{gap:10px}
.btns .big{background:rgba(255,255,255,.18);border:0;padding:18px;font-size:22px}
.btns #stop{background:transparent;border:2px solid rgba(255,255,255,.45)}
#run.stopw #pause{background:#fff;color:#0F1720;flex:2}
#done.d-emom .banner,#done.d-amrap .banner{color:#fff;border-radius:22px;padding:18px 18px 8px;margin-bottom:14px;box-shadow:0 8px 24px rgba(0,0,0,.18)}
#done.d-emom .banner{background:radial-gradient(120% 70% at 50% 0%,rgba(255,255,255,.2),transparent 60%),linear-gradient(170deg,rgba(255,255,255,.1),rgba(0,0,0,.22)),var(--work)}
#done.d-amrap .banner{background:radial-gradient(120% 70% at 50% 0%,rgba(255,255,255,.2),transparent 60%),linear-gradient(170deg,rgba(255,255,255,.1),rgba(0,0,0,.22)),var(--amr)}
#done .banner h1{margin-top:0}
#done.d-emom .banner .sub,#done.d-amrap .banner .sub,#done.d-emom .banner .hero span,#done.d-amrap .banner .hero span{color:rgba(255,255,255,.88)}
#done.d-emom .banner .hero b,#done.d-amrap .banner .hero b{color:#fff}
#done.d-emom .tile b{color:var(--work)}
#done.d-amrap .tile b{color:var(--amr)}
/* fin */
.list{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0}
.list span{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:6px 10px;font-variant-numeric:tabular-nums}
.tot{font:800 110px/1 "Barlow Condensed",sans-serif;margin:10px 0 0}

/* ===== habillage : dégradés, couleurs par mode, effets ===== */
@property --glow{syntax:'<color>';inherits:true;initial-value:#3D5CF0}
body{--glow:var(--work);transition:background-color .35s ease,--glow .6s ease;background-image:radial-gradient(130% 50% at 50% -8%,color-mix(in srgb,var(--glow) var(--gm),transparent),transparent 70%),linear-gradient(180deg,var(--bg2) 0%,var(--bg) 72%);background-repeat:no-repeat;background-attachment:fixed}
body[data-sm="pyramid"]{--glow:var(--pyr)}
body[data-sm="amrap"]{--glow:var(--amr)}
#modes button{--c:var(--work);border-color:color-mix(in srgb,var(--c) 40%,var(--line));color:color-mix(in srgb,var(--c) 72%,var(--mute))}
#modes [data-m="pyramid"]{--c:var(--pyr)}
#modes [data-m="amrap"]{--c:var(--amr)}
#modes button.on{background:linear-gradient(160deg,color-mix(in srgb,var(--c) 78%,#fff),var(--c));border-color:var(--c);color:#fff;box-shadow:0 6px 18px -4px color-mix(in srgb,var(--c) 60%,transparent)}
.seg button.on{background:linear-gradient(160deg,color-mix(in srgb,var(--glow) 78%,#fff),var(--glow));border-color:var(--glow);color:#fff}
.sw.on{background:linear-gradient(135deg,color-mix(in srgb,var(--glow) 75%,#fff),var(--glow))}
.sw::after{box-shadow:0 1px 4px rgba(0,0,0,.35)}
.rd.on{background:var(--glow);border-color:var(--glow)}
input.num:focus,input[type=text]:focus,input[type=number]:focus,input[type=date]:focus,select:focus{border-color:var(--glow);box-shadow:0 0 0 3px color-mix(in srgb,var(--glow) 25%,transparent);outline:0}
input[type=range]{accent-color:var(--glow)}
.row,.card,.tile{background:linear-gradient(180deg,color-mix(in srgb,var(--card) 92%,#fff),var(--card));box-shadow:0 1px 0 rgba(255,255,255,.05) inset,0 10px 22px -12px rgba(0,0,0,.55)}
:root[data-theme="light"] .row,:root[data-theme="light"] .card,:root[data-theme="light"] .tile{box-shadow:0 1px 2px rgba(15,23,32,.06),0 10px 22px -14px rgba(15,23,32,.3)}
.rd{background:linear-gradient(180deg,color-mix(in srgb,var(--card) 88%,#fff),var(--bg));box-shadow:0 2px 6px -2px rgba(0,0,0,.4)}
.rep .rd,.vb{box-shadow:none}
.big{background:linear-gradient(160deg,color-mix(in srgb,var(--glow) 80%,#fff),var(--glow))}
.big:not(.alt):not(.lapbtn){box-shadow:0 12px 26px -10px color-mix(in srgb,var(--glow) 70%,transparent),0 1px 0 rgba(255,255,255,.25) inset}
#setup h1,#perf h1{background:linear-gradient(90deg,var(--ink) 30%,color-mix(in srgb,var(--glow) 78%,var(--ink)));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.wide{background:linear-gradient(180deg,color-mix(in srgb,var(--card) 90%,#fff),var(--bg));box-shadow:0 2px 8px -3px rgba(0,0,0,.4)}

/* correctif iPhone : champ date qui dépassait */
input[type=date]{-webkit-appearance:none;appearance:none;display:block;width:100%;min-width:0;max-width:100%;box-sizing:border-box;height:46px;text-align:left}
input[type=date]::-webkit-date-and-time-value{text-align:left;min-height:1.2em}
input[type=date]::-webkit-calendar-picker-indicator{margin:0}
.card label,.grid3 label{min-width:0;max-width:100%}
.grid3{min-width:0}
.grid3 input,.card input,.card select{min-width:0;max-width:100%;box-sizing:border-box}

/* ===== objectifs ===== */
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:8px;min-width:0}
#psub{margin:0 0 14px}
.gstats{display:flex;gap:8px;margin:0 0 12px;flex-wrap:wrap}
.gstats span{background:color-mix(in srgb,var(--glow) 14%,transparent);border:1px solid color-mix(in srgb,var(--glow) 35%,transparent);border-radius:999px;padding:5px 12px;font-weight:600;font-size:15px}
.gcard{background:linear-gradient(180deg,color-mix(in srgb,var(--card) 92%,#fff),var(--card));border:1px solid var(--line);border-radius:18px;padding:14px;margin-bottom:12px;box-shadow:0 1px 0 rgba(255,255,255,.05) inset,0 10px 22px -12px rgba(0,0,0,.55);animation:pin .35s ease}
.gcard.near{border-color:color-mix(in srgb,#FFD23F 70%,var(--line));box-shadow:0 0 0 1px rgba(255,210,63,.35),0 10px 26px -12px rgba(255,210,63,.6)}
.gh{display:flex;align-items:center;gap:10px}
.gi{font-size:28px;width:46px;height:46px;flex:none;border-radius:14px;display:flex;align-items:center;justify-content:center;background:color-mix(in srgb,var(--glow) 16%,transparent)}
.gt{flex:1;min-width:0}
.gt b{display:block;font:800 23px/1.1 "Barlow Condensed",sans-serif}
.gt small{color:var(--mute);font-size:13px}
.gacts{display:flex;gap:6px;flex:none}
.pbar{position:relative;height:24px;border-radius:12px;background:color-mix(in srgb,var(--ink) 11%,transparent);overflow:hidden;margin:12px 0}
.pbar i{position:absolute;left:0;top:0;bottom:0;border-radius:12px;background:linear-gradient(90deg,color-mix(in srgb,var(--glow) 60%,#fff),var(--glow));transition:width .9s cubic-bezier(.2,.8,.2,1)}
.pbar .pct{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font:800 14px Barlow,sans-serif;color:#fff;text-shadow:0 1px 3px rgba(0,0,0,.5)}
.gcard.near .pbar i{background:linear-gradient(90deg,#FFB020,#FFD23F)}
.gl{display:flex;align-items:center;justify-content:space-between;gap:10px}
.gr{text-align:right}
.gr small{display:block;color:var(--mute);font-size:12px}
.gr .grem{font-weight:800}
.gcard.dn{border-color:color-mix(in srgb,#E7B416 55%,var(--line));background:linear-gradient(135deg,color-mix(in srgb,#E7B416 18%,var(--card)),var(--card))}
.x.conf{width:auto;padding:0 10px;font-size:14px;color:#fff;background:#D42B36;border-color:#D42B36}
#party{position:fixed;inset:0;z-index:60;display:flex;align-items:center;justify-content:center;background:rgba(5,8,14,.74);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);animation:fadein .3s}
.pcard{position:relative;z-index:2;text-align:center;background:linear-gradient(160deg,#FFE27A,#E7A800);color:#3A2600;border-radius:28px;padding:28px 26px;width:min(86vw,360px);box-shadow:0 20px 60px rgba(0,0,0,.5);animation:ppop .6s cubic-bezier(.2,1.4,.4,1)}
.trophy{font-size:84px;line-height:1;animation:bounce 1s ease infinite}
.pcard h2{font:800 40px "Barlow Condensed",sans-serif;margin:6px 0}
.pcard p{margin:0 0 16px;font-weight:600;font-size:18px}
#party-ok{background:#3A2600;color:#FFE27A;box-shadow:none}
#confetti{position:absolute;inset:0;overflow:hidden;pointer-events:none}
#confetti i{position:absolute;top:-5vh;width:var(--w);height:calc(var(--w)*1.6);background:var(--c);border-radius:2px;animation:fall var(--t) linear var(--d) both}
@keyframes fall{from{transform:translateY(-8vh) rotate(0)}to{transform:translateY(112vh) rotate(var(--r))}}
@keyframes ppop{from{transform:scale(.3);opacity:0}to{transform:none;opacity:1}}
@keyframes bounce{50%{transform:translateY(-10px) scale(1.08)}}
@keyframes fadein{from{opacity:0}}
#toast{position:fixed;left:50%;bottom:calc(96px + env(safe-area-inset-bottom,0px));transform:translate(-50%,30px);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:999px;font-weight:600;opacity:0;pointer-events:none;transition:opacity .3s,transform .3s;z-index:70;max-width:90vw;text-align:center}
#toast.show{opacity:1;transform:translate(-50%,0)}
.gacts .x:not(.conf),.gacts .x.del:not(.conf){width:38px;height:38px;font-size:21px;padding:0}

/* sélecteur d'exercice compact */
.pk{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:10px}
.pk label{margin:0;font-size:12px;letter-spacing:.4px;text-transform:uppercase;font-weight:600;min-width:0}
.pk .pk-wide{grid-column:1/-1}
.pk select,.pk input{height:42px;margin-top:4px;padding:0 10px;font-size:16px;border-radius:12px;text-overflow:ellipsis;text-transform:none;letter-spacing:0;font-weight:400}
.pk select{-webkit-appearance:none;appearance:none;padding-right:28px;background:linear-gradient(45deg,transparent 50%,var(--mute) 50%) calc(100% - 17px) 54%/6px 6px no-repeat,linear-gradient(135deg,var(--mute) 50%,transparent 50%) calc(100% - 11px) 54%/6px 6px no-repeat,var(--bg)}
/* iOS : pas de zoom automatique à la saisie (police des champs >= 16px) */
input:not([type=range]):not([type=color]):not([type=checkbox]):not(.num),select,textarea{font-size:16px!important}

/* plein écran iOS (écran d'accueil) : bandeau sombre derrière l'heure en thème clair */
:root[data-theme="light"] body:not(.work):not(.rest):not(.wait)::before{content:"";position:fixed;top:0;left:0;right:0;height:env(safe-area-inset-top,0px);background:#14191F;z-index:80;pointer-events:none}

/* paramètres : bouton rond dans la barre + bulle */

/* interrupteurs : taille fixe, jamais étirés par la barre d'onglets */

#bk{position:fixed;inset:0;z-index:65;display:flex;align-items:center;justify-content:center;padding:16px;background:rgba(5,8,14,.72);-webkit-backdrop-filter:blur(6px);backdrop-filter:blur(6px);animation:fadein .25s}
.bkcard{background:linear-gradient(180deg,color-mix(in srgb,var(--card) 92%,#fff),var(--card));border:1px solid var(--line);border-radius:24px;padding:18px;width:min(100%,420px);max-height:90vh;overflow:auto;box-shadow:0 24px 60px -12px rgba(0,0,0,.6);animation:ppop .4s cubic-bezier(.2,1.2,.4,1)}
.filebtn{display:block;text-align:center;cursor:pointer;box-sizing:border-box}
#bk textarea{display:block;width:100%;box-sizing:border-box;margin-top:8px;border-radius:12px;border:1px solid var(--line);background:var(--bg);color:var(--ink);padding:10px;font-family:inherit;resize:vertical}
#profile .card{background:var(--panel,var(--bg));border:1px solid var(--line);border-radius:16px}
#profile input:focus{outline:2px solid var(--accent,#3D5CF0);outline-offset:1px}
#profile label{display:block;font-size:14px}
#profile .wide{width:100%}

/* ===== barre de navigation du bas ===== */
#tabs{position:fixed;left:50%;bottom:calc(12px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);z-index:40;display:flex;gap:6px;padding:6px;width:min(calc(100% - 32px),360px);border-radius:30px;background:color-mix(in srgb,var(--card) 78%,transparent);-webkit-backdrop-filter:blur(18px) saturate(1.4);backdrop-filter:blur(18px) saturate(1.4);border:1px solid color-mix(in srgb,var(--ink) 10%,transparent);box-shadow:0 14px 34px -10px rgba(0,0,0,.55),0 1px 0 rgba(255,255,255,.06) inset}
#tabs>button{all:unset;position:relative;z-index:1;box-sizing:border-box;flex:1 1 0;height:52px;border-radius:24px;display:flex;align-items:center;justify-content:center;cursor:pointer;-webkit-tap-highlight-color:transparent;transition:background-color .3s,box-shadow .3s,transform .2s}
#tabs .ti{font-size:25px;line-height:1;filter:grayscale(.75);opacity:.62;transition:transform .35s cubic-bezier(.3,1.5,.5,1),filter .3s,opacity .3s}
#tabs>button.on .ti{filter:none;opacity:1;transform:scale(1.12);animation:tiPop .55s cubic-bezier(.3,1.6,.5,1)}
#tabs>button:active{transform:scale(.93)}
#tabs>button:focus-visible{outline:3px solid #FFB020;outline-offset:2px}
#profile{padding-bottom:calc(112px + env(safe-area-inset-bottom,0px))!important}
/* ===== page Paramètres ===== */
.sec{margin:20px 4px 8px;font:700 13px Barlow,sans-serif;letter-spacing:1.4px;text-transform:uppercase;color:var(--mute)}
#settings .sc{padding:2px 14px;margin:0}
#settings .row{background:none;box-shadow:none;border:0;border-bottom:1px solid var(--line);border-radius:0;margin:0;padding:14px 0;gap:12px}
#settings .row:last-child{border-bottom:0}
#settings .row>div:first-child{min-width:0;flex:1}
#settings .sw{flex:none;width:52px;height:30px;padding:0;border:0;border-radius:15px;font-size:0}
#settings .tsw{flex:none;width:76px;height:40px;padding:0;border:0;border-radius:20px;font-size:0}
#settings input[type=range]{width:min(46vw,190px)}
#settings h1{background:linear-gradient(90deg,var(--ink) 30%,color-mix(in srgb,var(--glow) 78%,var(--ink)));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}

/* ===== changement de page : glissement + pastille ===== */
#tabs .pill{position:absolute;top:6px;bottom:6px;left:6px;width:calc((100% - 30px)/4);border-radius:24px;background:linear-gradient(160deg,color-mix(in srgb,var(--glow) 82%,#fff),var(--glow));box-shadow:0 8px 20px -8px color-mix(in srgb,var(--glow) 75%,transparent);transform:translateX(calc(var(--i,0)*(100% + 6px)));transition:transform .5s cubic-bezier(.3,1.25,.45,1);z-index:0;pointer-events:none}
@keyframes tiPop{0%{transform:scale(.7)}60%{transform:scale(1.3)}100%{transform:scale(1.12)}}
html.pgt #tabs{view-transition-name:tabbar}
html.pgt::view-transition-group(tabbar){animation:none}
html.pgt::view-transition-old(tabbar){display:none}
html.pgt::view-transition-new(tabbar){animation:none}
html.pgt::view-transition-old(root){animation:pgOutF .45s cubic-bezier(.4,0,.2,1) both}
html.pgt::view-transition-new(root){animation:pgInF .45s cubic-bezier(.2,.8,.2,1) both}
html[data-dir="back"].pgt::view-transition-old(root){animation-name:pgOutB}
html[data-dir="back"].pgt::view-transition-new(root){animation-name:pgInB}
@keyframes pgOutF{to{transform:translateX(-32%);opacity:.35;filter:blur(2px)}}
@keyframes pgInF{from{transform:translateX(100%)}to{transform:none}}
@keyframes pgOutB{to{transform:translateX(32%);opacity:.35;filter:blur(2px)}}
@keyframes pgInB{from{transform:translateX(-100%)}to{transform:none}}
main.pgin-f,#profile.pgin-f{animation:slF .42s cubic-bezier(.2,.8,.2,1) both}
main.pgin-b,#profile.pgin-b{animation:slB .42s cubic-bezier(.2,.8,.2,1) both}
@keyframes slF{from{transform:translateX(70px);opacity:0}to{transform:none;opacity:1}}
@keyframes slB{from{transform:translateX(-70px);opacity:0}to{transform:none;opacity:1}}

/* ===== icônes : traits fins, une seule couleur (hérite du texte) ===== */
.ic{width:1.15em;height:1.15em;flex:none;fill:none;stroke:currentColor;stroke-width:1.9;stroke-linecap:round;stroke-linejoin:round;vertical-align:-.2em;overflow:visible}
.seg button .ic,.big .ic,.wide .ic,.gstats .ic,.gold .ic,.ic-l .ic{margin-right:.45em}
.ic-l{display:inline-block}
.chev .ic{width:1em;height:1em;margin:0;vertical-align:-.15em}
.rd .ic,.x .ic,.vb .ic,#tabs .ic,.pico .ic,.vs .ic,.k .ic,.gi .ic,.trophy .ic{margin:0}
#tabs .ti{display:flex;align-items:center;justify-content:center;color:var(--mute);filter:none}
#tabs .ti .ic{width:25px;height:25px;stroke-width:1.7}
#tabs>button.on .ti{color:#fff}
#tabs>button.on .ti .ic{stroke-width:2.2}
.vb .ic{width:22px;height:22px}
.vs span{display:flex;justify-content:center}
.vs span .ic{width:20px;height:20px}
.pico .ic{width:1em;height:1em;stroke:none;fill:currentColor}
.x .ic{width:19px;height:19px}
.x.del{color:#E5484D}
.gi .ic{width:26px;height:26px}
.trophy .ic{width:84px;height:84px;stroke-width:1.4}
.gold span{display:inline-flex;align-items:center}
.list span[data-i] .ic{width:.9em;height:.9em;margin:0 0 0 .15em}
.tsw,.tsw.on{background:var(--line)}
.tsw.on{background:linear-gradient(135deg,color-mix(in srgb,var(--glow) 75%,#fff),var(--glow))}
.tsw .k{color:#111}
.tsw .k .ic{width:19px;height:19px;margin:0}

/* ===== amis et profil ===== */
.me{display:flex;align-items:center;gap:14px}
.me h3{margin:0;word-break:break-word}
.me .sub{margin:2px 0 0}
.avatar{width:44px;height:44px;border-radius:50%;flex:none;display:inline-flex;align-items:center;justify-content:center;overflow:hidden;background:linear-gradient(160deg,color-mix(in srgb,var(--glow) 70%,#fff),var(--glow));color:#fff;font:800 17px "Barlow Condensed",Barlow,sans-serif;letter-spacing:.5px;border:1px solid color-mix(in srgb,var(--ink) 12%,transparent)}
.avatar img{width:100%;height:100%;object-fit:cover;display:block}
.avatar.big{width:76px;height:76px;font-size:30px}
.avatarbtn{all:unset;position:relative;cursor:pointer;flex:none;border-radius:50%;-webkit-tap-highlight-color:transparent}
.avatarbtn:focus-visible{outline:3px solid #FFB020;outline-offset:3px}
.avatarbtn .cam{position:absolute;right:-2px;bottom:-2px;width:28px;height:28px;border-radius:50%;background:var(--ink);color:var(--bg);display:flex;align-items:center;justify-content:center;border:2px solid var(--card)}
.avatarbtn .cam .ic{width:15px;height:15px;margin:0}
.frh{display:flex;align-items:center;gap:8px;margin:0 0 12px;font-size:20px}
.frsearch{display:flex;gap:8px;align-items:center}
.frsearch input{flex:1;min-width:0;height:44px;border-radius:12px;border:1px solid var(--line);background:var(--bg);color:var(--ink);padding:0 12px;margin:0}
.frrow{display:flex;align-items:center;gap:12px;width:100%;box-sizing:border-box;padding:10px 0;border-bottom:1px solid var(--line);text-align:left}
.frrow:last-child{border-bottom:0}
button.frrow{all:unset;display:flex;align-items:center;gap:12px;width:100%;box-sizing:border-box;padding:10px 0;border-bottom:1px solid var(--line);cursor:pointer;-webkit-tap-highlight-color:transparent}
button.frrow:active{opacity:.6}
.frrow .nm{flex:1;min-width:0;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.frrow small{display:block;color:var(--mute);font-weight:400;font-size:13px}
.frrow .acts2{display:flex;gap:6px;flex:none}
.frrow .rd .ic{margin:0;width:19px;height:19px}
.frrow .pillbtn{all:unset;cursor:pointer;padding:8px 14px;border-radius:999px;font-weight:700;font-size:14px;background:linear-gradient(160deg,color-mix(in srgb,var(--glow) 80%,#fff),var(--glow));color:#fff}
.frrow .tag{color:var(--mute);font-size:13px;font-weight:600}
#social h4.sec,#friend-view h4.sec{margin:18px 2px 6px}
#fv-table .tw{margin-top:8px}
#tabs>button.has-badge::after{content:"";position:absolute;top:8px;right:20%;width:11px;height:11px;border-radius:50%;background:#E5484D;border:2px solid var(--card)}
</style>
