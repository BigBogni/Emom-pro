 const byName=(a,b)=>String((profCache.get(otherOf(a))||{}).displayName||"").localeCompare(String((profCache.get(otherOf(b))||{}).displayName||""));
 $("#fr-list").innerHTML=fr.sort(byName).map(f=>personRow(otherOf(f),"",true)).join("");
 $("#fr-empty").classList.toggle("hide",fr.length>0);if(!fr.length)$("#fr-empty").textContent="Aucun ami pour l'instant. Cherche un pseudo ci-dessus pour envoyer une demande.";
 $("#fr-count").textContent=fr.length?`(${fr.length})`:"";
 $("#fr-in-wrap").classList.toggle("hide",!inn.length);$("#fr-in").innerHTML=inn.map(f=>personRow(otherOf(f),`<button type="button" class="rd" data-acc="${escH(f.id)}" aria-label="Accepter">${ic("check")}</button><button type="button" class="rd" data-dec="${escH(f.id)}" aria-label="Refuser">${ic("x")}</button>`)).join("");
 $("#fr-out-wrap").classList.toggle("hide",!out.length);$("#fr-out").innerHTML=out.map(f=>personRow(otherOf(f),`<span class="tag">En attente</span><button type="button" class="rd" data-cancel="${escH(f.id)}" aria-label="Annuler la demande">${ic("x")}</button>`)).join("");
 document.querySelector('#tabs [data-t="profile"]')?.classList.toggle("has-badge",inn.length>0);
 renderResults();
 if(viewUid&&relation(viewUid)?.t!=="friend"&&!$("#friend-view").classList.contains("hide"))closeFriend();
}
function renderResults(){const el=$("#fr-results");
 el.innerHTML=searchRes.map(({id,p})=>{const rel=relation(id);
  const act=!rel?`<button type="button" class="pillbtn" data-add="${escH(id)}">Ajouter</button>`:rel.t==="friend"?`<span class="tag">Ami</span>`:rel.t==="out"?`<span class="tag">Demande envoyée</span>`:`<button type="button" class="pillbtn" data-acc="${escH(rel.f.id)}">Accepter</button>`;
  return `<div class="frrow">${avatar(p)}<span class="nm">${escH(p.displayName||"Utilisateur")}</span><span class="acts2">${act}</span></div>`}).join("")}
async function searchFriends(){const q=hSan($("#fr-q").value),msgF=t=>$("#fr-msg").textContent=t;
 searchRes=[];renderResults();
 if(q.length<2){msgF("Écris au moins 2 lettres du pseudo.");return}
 msgF("Recherche…");
 try{const snap=await getDocs(query(collection(db,"profiles"),where("handle",">=",q),where("handle","<=",q+"\uf8ff"),limit(10)));
  searchRes=snap.docs.filter(d=>d.id!==currentUser.uid).map(d=>{profCache.set(d.id,d.data());return{id:d.id,p:d.data()}});
  msgF(searchRes.length?"":"Aucun profil trouvé avec ce pseudo.");renderResults()}
 catch(e){msgF("Recherche impossible. Vérifie les règles Firestore.")}}
$("#fr-go").addEventListener("click",searchFriends);
$("#fr-q").addEventListener("keydown",e=>{if(e.key==="Enter"){e.preventDefault();searchFriends()}});
$("#fr-card").addEventListener("click",async e=>{const b=e.target.closest("button");if(!b||!currentUser)return;const me=currentUser.uid,msgF=t=>$("#fr-msg").textContent=t;
 try{
  if(b.dataset.open)openFriend(b.dataset.open);
  else if(b.dataset.add){const uid=b.dataset.add;b.disabled=true;
   await setDoc(doc(db,"friendships",pairId(me,uid)),{members:[me,uid].sort(),requester:me,status:"pending",createdAt:serverTimestamp()});msgF("Demande envoyée.")}
  else if(b.dataset.acc){await updateDoc(doc(db,"friendships",b.dataset.acc),{status:"accepted"});msgF("Ami ajouté.")}
  else if(b.dataset.dec||b.dataset.cancel){await deleteDoc(doc(db,"friendships",b.dataset.dec||b.dataset.cancel))}
 }catch(err){msgF("Action impossible. Vérifie les règles Firestore et ta connexion.")}});

// ---- profil d'un ami
function showFriendPanel(open){$("#friend-view").classList.toggle("hide",!open);$("#user-panel").classList.toggle("hide",open||!currentUser);$("#social").classList.toggle("hide",open||!currentUser);
 document.querySelectorAll("#profile>h2,#profile>.sub").forEach(x=>x.classList.toggle("hide",open))}
function closeFriend(){viewUid=null;showFriendPanel(false)}
let fvData=null;
async function openFriend(uid){viewUid=uid;const p=profCache.get(uid)||{displayName:"Utilisateur"};
 showFriendPanel(true);try{window.scrollTo(0,0)}catch(e){}
 $("#fv-avatar").innerHTML=avatar(p,"big");$("#fv-name").textContent=p.displayName||"Utilisateur";$("#fv-sub").textContent="";
 $("#fv-goals").innerHTML='<p class="sub">Chargement…</p>';$("#fv-table").innerHTML="";$("#fv-filter").innerHTML="";fvData=null;
 setFvTab("goals");
 try{const snap=await getDoc(doc(db,"shared",uid));if(viewUid!==uid)return;
  const d=snap.exists()?snap.data():null;
  if(!d||d.private){const t='<p class="sub">Cet ami ne partage pas ses performances ni ses objectifs.</p>';$("#fv-goals").innerHTML=t;$("#fv-table").innerHTML=t;return}
  fvData=d;const B=window.__emomBridge;
  $("#fv-goals").innerHTML=B.friendGoalsHTML(d.goals);
  const labels=B.friendPerfLabels(d.perf);$("#fv-filter").innerHTML='<option value="">Tous les exercices</option>'+labels.map(l=>`<option value="${escH(l)}">${escH(l)}</option>`).join("");
  $("#fv-table").innerHTML=B.friendPerfHTML(d.perf,"");
  const n=(Array.isArray(d.perf)?d.perf.length:0),g=(Array.isArray(d.goals)?d.goals.length:0);$("#fv-sub").textContent=`${n} performance(s) · ${g} objectif(s)`}
 catch(e){$("#fv-goals").innerHTML='<p class="sub">Impossible de charger ce profil. Vérifie les règles Firestore.</p>'}}
function setFvTab(t){document.querySelectorAll("#fv-tabs [data-fv]").forEach(b=>b.classList.toggle("on",b.dataset.fv===t));$("#fv-goals").classList.toggle("hide",t!=="goals");$("#fv-perf").classList.toggle("hide",t!=="perf")}
document.querySelectorAll("#fv-tabs [data-fv]").forEach(b=>b.addEventListener("click",()=>setFvTab(b.dataset.fv)));
$("#fv-filter").addEventListener("change",()=>{if(fvData)$("#fv-table").innerHTML=window.__emomBridge.friendPerfHTML(fvData.perf,$("#fv-filter").value)});
$("#fv-back").addEventListener("click",closeFriend);
$("#fv-remove").addEventListener("click",async()=>{const b=$("#fv-remove"),rel=viewUid&&relation(viewUid);if(!rel)return;
 if(!b.dataset.armed){b.dataset.armed=1;b.textContent="Sûr ? Re-touche pour retirer";setTimeout(()=>{delete b.dataset.armed;b.textContent="Retirer cet ami"},3000);return}
 delete b.dataset.armed;b.textContent="Retirer cet ami";
 try{await deleteDoc(doc(db,"friendships",rel.f.id));closeFriend()}catch(e){$("#fv-sub").textContent="Impossible de retirer cet ami."}});
const prevRefresh=window.__refreshProfile;
window.__refreshProfile=()=>{prevRefresh&&prevRefresh();if(currentUser&&frList.length){profCache=new Map([[currentUser.uid,myProfile]]);loadProfiles().then(renderFriends)}};
onAuthStateChanged(auth,async user=>{
 currentUser=user||null;
 authPanel.classList.toggle("hide",!!user);userPanel.classList.toggle("hide",!user);
 $("#social").classList.toggle("hide",!user);$("#friend-view").classList.add("hide");
 if(!user){$("#sync-status").textContent="";setMode(false);stopFriends();myProfile={};return}
 $("#profile-name").textContent=user.displayName||user.email?.split("@")[0]||"Sportif";
 $("#profile-email").textContent=user.email||"Compte Google";
 $("#sync-status").textContent="Récupération des données…";
 try{
  loadingRemote=true;
  const snap=await getDoc(doc(db,"users",user.uid));
  const remote=snap.exists()?snap.data():{};
  const cloud=remote.emom;
  if(cloud&&Array.isArray(cloud.perf)){
   // Le cloud est la référence à la connexion pour garantir la reprise sur un autre appareil.
   window.__emomBridge?.setData({perf:cloud.perf,goals:cloud.goals||[],presets:cloud.presets||[]});
  }else{
   const d=localData();
   await setDoc(doc(db,"users",user.uid),{
    profile:{displayName:user.displayName||user.email?.split("@")[0]||"Sportif",email:user.email||""},
    emom:{perf:d.perf,goals:d.goals,presets:d.presets},updatedAt:serverTimestamp()
   },{merge:true});
  }
  $("#sync-status").textContent="Données chargées et synchronisées avec Firestore.";
 }catch(e){$("#sync-status").textContent="Impossible de charger Firestore. Vérifie les règles de sécurité et la configuration du projet."}
 finally{loadingRemote=false;stats()}
 // ---- amis : profil public + données partagées
 try{await ensureProfile(user);await setDoc(doc(db,"shared",user.uid),{...sharedPayload(localData()),updatedAt:serverTimestamp()})}
 catch(e){$("#fr-empty").classList.remove("hide");$("#fr-empty").textContent="Les amis ne sont pas encore activés : publie les nouvelles règles Firestore (voir le fichier firestore.rules)."}
 startFriends(user);
});
</script>


